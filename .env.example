NEXT_PUBLIC_SITE_URL=http://localhost:3000
V2_PUBLIC_ORIGIN=http://localhost:3000
V2_PUBLIC_DATA_SOURCE=fixtures
DATABASE_URL=
DATABASE_POOL_MAX=5
# JSON: {"current":"v1","keys":{"v1":"<base64url-encoded 32-byte key>"}}
SESSION_SIGNING_KEYS=
# JSON: {"current":1,"keys":{"1":"<base64url-encoded 32-byte key>"}}
TOTP_ENCRYPTION_KEYS=
# Canonical base64url-encoded 32-byte HMAC pepper; never reuse either keyring key.
V2_AUTH_RATE_LIMIT_PEPPER=
# Fixture auth also requires a loopback origin and a short-lived verifier-owned proof file, and is disabled on every Vercel runtime.
# V2_TEST_AUTH_PROOF_PATH, V2_TEST_AUTH_RUNNER_PID, and V2_TEST_AUTH_RUNNER_TOKEN are injected only by scripts/verify-auth-http.mjs; never configure them manually.
V2_TEST_AUTH_ENABLED=false
V2_TEST_AUTH_SECRET=
V2_TEST_AUTH_FIXTURES_JSON=

# Riot integration is fail-closed. Production wiring requires every value below,
# V2_PUBLIC_DATA_SOURCE=postgres, the database feature flag, and exact callback URI.
V2_RIOT_INTEGRATION_ENABLED=false
V2_RIOT_FAKE_RUNTIME=false
RIOT_API_REGIONAL_ROUTE=asia
RIOT_API_PLATFORM_ROUTE=kr
RIOT_API_KEY=
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_RSO_REDIRECT_URI=http://localhost:3000/api/me/riot/rso/callback
# Independent high-entropy HMAC secret, minimum 32 characters.
RIOT_RSO_STATE_SECRET=
# JSON: {"current":"v1","keys":{"v1":"<base64url-encoded 32-byte key>"}}
RIOT_ENCRYPTION_KEYS=
RIOT_REQUEST_TIMEOUT_MS=5000
# Shared by signed internal job routes; never expose it to a browser.
OPERATIONS_JOB_SECRET=

# AI completion is disabled unless every value below is valid. Keep the feature
# flag in site settings off until the adapter and budget have been verified.
V2_OPENAI_COMPLETION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Configure current contract rates explicitly; the app does not guess changing prices.
OPENAI_INPUT_MICROS_PER_MILLION_TOKENS=
OPENAI_OUTPUT_MICROS_PER_MILLION_TOKENS=
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_REQUEST_TIMEOUT_MS=15000
