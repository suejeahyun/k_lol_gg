# Separate GG HUB deployment. Never populate this with child-site credentials.
NEXT_PUBLIC_SERVICE_ID=hub
NEXT_PUBLIC_SITE_URL=http://localhost:3110
V2_PUBLIC_ORIGIN=http://localhost:3110
V2_PUBLIC_DATA_SOURCE=postgres
HUB_DATABASE_URL=
HUB_DATABASE_NAME=gg_hub_local
DATABASE_POOL_MAX=3
COMMUNITY_NETWORK_ENABLED=true
COMMUNITY_SITES_ENABLED=true
# Enable only after the adapter, independent child deployment and SSO smoke pass.
HUB_PROVISIONING_ENABLED=false
HUB_VERCEL_TOKEN=
HUB_VERCEL_TEAM_ID=
HUB_NEON_API_KEY=
HUB_NEON_ORG_ID=
HUB_NEON_REGION=aws-ap-southeast-1
HUB_PROVISIONING_MASTER_KEY=
HUB_ENGINE_GITHUB_REPO_ID=
# Exact tested 40-character Git commit; never a moving branch.
HUB_ENGINE_GIT_REF=
CRON_SECRET=
SESSION_SIGNING_KEYS=
TOTP_ENCRYPTION_KEYS=
V2_AUTH_RATE_LIMIT_PEPPER=
V2_TEST_AUTH_ENABLED=false
V2_RIOT_INTEGRATION_ENABLED=false
V2_RIOT_FAKE_RUNTIME=false
V2_OPENAI_COMPLETION_ENABLED=false
V2_CRON_ENABLED=false
KAKAO_SITE_NOTICE_ENABLED=false
USAGE_ANALYTICS_ENABLED=false
