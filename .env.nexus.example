# Copy into an ignored .env.local, then provide only NEW NEXUS credentials.
NEXT_PUBLIC_SERVICE_ID=nexus
NEXT_PUBLIC_SITE_URL=http://localhost:3107
V2_PUBLIC_ORIGIN=http://localhost:3107
V2_PUBLIC_DATA_SOURCE=postgres
NEXUS_DATABASE_URL=
NEXUS_DATABASE_NAME=nexus_gg
DATABASE_POOL_MAX=1
# Set only while initializing the new database; do not import K-LOL records.
NEXUS_BOOTSTRAP_CONFIRM=CREATE_EMPTY_NEXUS
# Independent 32-byte base64url keys. JSON format matches .env.example.
SESSION_SIGNING_KEYS=
TOTP_ENCRYPTION_KEYS=
V2_AUTH_RATE_LIMIT_PEPPER=
V2_TEST_AUTH_ENABLED=false
V2_RIOT_INTEGRATION_ENABLED=false
V2_RIOT_FAKE_RUNTIME=false
V2_OPENAI_COMPLETION_ENABLED=false
V2_CRON_ENABLED=false
OPERATIONS_JOB_SECRET=
CRON_SECRET=
KAKAO_WEBHOOK_SECRET_CURRENT=
KAKAO_WEBHOOK_KEY_ID_CURRENT=nexus-current
KAKAO_WEBHOOK_PRINCIPAL_ID=bot:nexus
KAKAO_V4_IDENTITY_SECRET=
KAKAO_V4_WEBHOOK_SECRET_CURRENT=
KAKAO_V4_WEBHOOK_KEY_ID_CURRENT=nexus-v4-current
KAKAO_SITE_NOTICE_ENABLED=false
USAGE_ANALYTICS_ENABLED=false
USAGE_ANALYTICS_SECRET=
# Phone build only. Set a verified NEXUS URL after hosting is ready.
# Use the SAME NEXUS values as KAKAO_V4_* above, never K-LOL values.
NEXUS_V2_BASE_URL=
NEXUS_V4_KAKAO_IDENTITY_SECRET=
NEXUS_V4_KAKAO_WEBHOOK_SECRET_CURRENT=
NEXUS_V4_KAKAO_WEBHOOK_KEY_ID_CURRENT=nexus-v4-current
# Optional independent private upload store. Never connect the K-LOL store.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
